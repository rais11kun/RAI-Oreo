<?xml version="1.0" encoding="utf-8"?>
<!-- Layar Login — dibuat ulang mengikuti desain versi Jetpack Compose (gradien navy→biru di belakang, logo 112dp, wordmark + "M O B I L E", lalu sheet putih bersudut atas 28dp berisi form). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    tools:ignore="HardcodedText">

    <!-- Blok gradien setinggi 330dp; konten bergulir di atasnya -->
    <View
        android:layout_width="match_parent"
        android:layout_height="330dp"
        android:background="@drawable/bg_login_gradient" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ============================ bagian atas di atas gradien -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="55dp"
                android:paddingEnd="24dp">

                <ImageView
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/logo_simper_white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/poppins_bold"
                    android:includeFontPadding="false"
                    android:text="SIMPER-NRA"
                    android:textColor="@color/white"
                    android:textSize="32sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:letterSpacing="0.28"
                    android:text="M O B I L E"
                    android:textColor="@color/orange"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/poppins_regular"
                    android:gravity="center"
                    android:text="Cetak Lebih Mudah, Pantau Lebih Cepat"
                    android:textColor="#D9FFFFFF"
                    android:textSize="13sp" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="26dp" />
            </LinearLayout>

            <!-- ========================================= sheet form putih -->
            <LinearLayout
                android:id="@+id/sheetLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_login_sheet"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="22dp"
                android:paddingEnd="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="4dp"
                    android:text="Selamat Datang&#10;di SIMPER-NRA Mobile"
                    android:textColor="@color/navy800"
                    android:textSize="24sp"
                    android:gravity="center" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/poppins_regular"
                    android:gravity="center"
                    android:text="Masuk untuk memesan layanan percetakan dan pantau pesanan Anda."
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <!-- email -->
                <LinearLayout
                    android:id="@+id/boxEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:minHeight="60dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="Email"
                        android:src="@drawable/ic_mail"
                        app:tint="@color/body" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_medium"
                            android:includeFontPadding="false"
                            android:text="Email"
                            android:textColor="@color/muted"
                            android:textSize="11sp" />

                        <EditText
                            android:id="@+id/etEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:fontFamily="@font/poppins_medium"
                            android:hint="nama@email.com"
                            android:importantForAutofill="no"
                            android:includeFontPadding="false"
                            android:inputType="textEmailAddress"
                            android:maxLines="1"
                            android:paddingTop="3dp"
                            android:paddingBottom="0dp"
                            android:textColor="@color/ink"
                            android:textColorHint="@color/muted"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvEmailError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/red"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="Email wajib diisi"
                    tools:visibility="visible" />

                <!-- password -->
                <LinearLayout
                    android:id="@+id/boxPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:minHeight="60dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="Password"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/body" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_medium"
                            android:includeFontPadding="false"
                            android:text="Password"
                            android:textColor="@color/muted"
                            android:textSize="11sp" />

                        <EditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:fontFamily="@font/poppins_medium"
                            android:hint="Masukkan password"
                            android:importantForAutofill="no"
                            android:includeFontPadding="false"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:paddingTop="3dp"
                            android:paddingBottom="0dp"
                            android:textColor="@color/ink"
                            android:textColorHint="@color/muted"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivTogglePassword"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="Tampilkan password"
                        android:focusable="true"
                        android:padding="7dp"
                        android:src="@drawable/ic_eye"
                        app:tint="@color/muted" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPasswordError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/red"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="Password minimal 4 karakter"
                    tools:visibility="visible" />

                <!-- ingat saya / lupa sandi -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbIngat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="true"
                        android:fontFamily="@font/poppins_regular"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:text="Ingat saya"
                        android:textColor="@color/ink"
                        android:textSize="13sp"
                        app:useMaterialThemeColors="true" />

                    <TextView
                        android:id="@+id/tvLupa"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:padding="6dp"
                        android:text="Lupa password?"
                        android:textColor="@color/blue"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- masuk -->
                <FrameLayout
                    android:id="@+id/btnMasuk"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_btn_primary"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/poppins_semibold"
                        android:gravity="center"
                        android:text="Masuk"
                        android:textColor="@color/white"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="18dp"
                        android:contentDescription="Masuk"
                        android:src="@drawable/ic_forward"
                        app:tint="@color/white" />
                </FrameLayout>

                <!-- "atau" -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/border" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_regular"
                        android:paddingHorizontal="12dp"
                        android:text="atau"
                        android:textColor="@color/muted"
                        android:textSize="11sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/border" />
                </LinearLayout>

                <!-- google -->
                <LinearLayout
                    android:id="@+id/btnGoogle"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_btn_outline_gray"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="Google"
                        android:src="@drawable/ic_google" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Masuk dengan Google"
                        android:textColor="@color/navy800"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- sidik jari -->
                <LinearLayout
                    android:id="@+id/btnSidikJari"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_btn_fingerprint"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivSidik"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Sidik jari"
                        android:src="@drawable/ic_fingerprint"
                        app:tint="@color/blue" />

                    <TextView
                        android:id="@+id/tvSidik"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Masuk dengan Fingerprint"
                        android:textColor="@color/primary_dark"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvBioNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/poppins_regular"
                    android:gravity="center"
                    android:text="Fingerprint belum tersedia di perangkat ini"
                    android:textColor="@color/muted"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/poppins_regular"
                    android:gravity="center"
                    android:textColor="@color/blue"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="Gunakan email demo untuk sekarang."
                    tools:visibility="visible" />

                <!-- daftar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_regular"
                        android:text="Belum punya akun? "
                        android:textColor="@color/body"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvDaftar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:padding="4dp"
                        android:text="Daftar sekarang"
                        android:textColor="@color/blue"
                        android:textSize="13sp" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="22dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>
