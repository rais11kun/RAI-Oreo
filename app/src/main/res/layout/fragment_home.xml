<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F5F7FA" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="#07518A">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Halo,\nRais Wirdiyan!" android:textColor="#FFFFFF" android:textSize="23sp" android:textStyle="bold"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:padding="14dp" android:background="@drawable/bg_input" android:text="⌕  Cari layanan percetakan..." android:textColor="#66758A" android:textSize="16sp"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
   <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="190dp" app:cardCornerRadius="18dp" app:cardBackgroundColor="#0A5B9B">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="20dp">
     <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cetak Semua\nKebutuhan Anda\nBersama Kami" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"/>
     <Button android:id="@+id/btnMyProject" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginTop="12dp" android:backgroundTint="#FF8700" android:text="Pesan Sekarang  →" android:textColor="#FFFFFF"/>
    </LinearLayout>
   </com.google.android.material.card.MaterialCardView>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Pesanan Aktif" android:textColor="#102F59" android:textSize="21sp" android:textStyle="bold"/>
   <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardCornerRadius="16dp" app:cardBackgroundColor="#FFFFFF">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
     <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="#ORD00123     Diproses" android:textColor="#102F59" android:textStyle="bold" android:textSize="16sp"/>
     <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Banner 2 × 1 m" android:textColor="#66758A"/>
     <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="●━━━━●━━━━○━━━━○\nMasuk       Design       Produksi       Selesai" android:textColor="#168CE0" android:textSize="12sp"/>
    </LinearLayout>
   </com.google.android.material.card.MaterialCardView>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Layanan Populer" android:textColor="#102F59" android:textSize="21sp" android:textStyle="bold"/>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
    <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="110dp" android:layout_weight="1" android:layout_marginEnd="5dp" app:cardCornerRadius="14dp" app:cardBackgroundColor="#FFFFFF"><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="▤\nBanner\nMulai Rp20.000" android:textColor="#0A477A" android:textStyle="bold" android:textSize="13sp"/></com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="110dp" android:layout_weight="1" android:layout_marginHorizontal="3dp" app:cardCornerRadius="14dp" app:cardBackgroundColor="#FFFFFF"><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="▰\nSpanduk\nMulai Rp15.000" android:textColor="#0A477A" android:textStyle="bold" android:textSize="13sp"/></com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="110dp" android:layout_weight="1" android:layout_marginStart="5dp" app:cardCornerRadius="14dp" app:cardBackgroundColor="#FFFFFF"><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="◉\nStiker\nMulai Rp5.000" android:textColor="#0A477A" android:textStyle="bold" android:textSize="13sp"/></com.google.android.material.card.MaterialCardView>
   </LinearLayout>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Promo Spesial" android:textColor="#102F59" android:textSize="21sp" android:textStyle="bold"/>
   <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="110dp" android:layout_marginTop="10dp" app:cardCornerRadius="16dp" app:cardBackgroundColor="#07518A"><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:padding="20dp" android:text="Diskon Hingga 30%\nUntuk semua layanan cetak" android:textColor="#FFFFFF" android:textSize="19sp" android:textStyle="bold"/></com.google.android.material.card.MaterialCardView>
   <Button android:id="@+id/btnOpenWeb" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:backgroundTint="#FFFFFF" android:text="Info Percetakan" android:textColor="#07518A"/>
   <Button android:id="@+id/btnDeveloperProfile" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp" android:backgroundTint="#FFFFFF" android:text="Profil Pengembang" android:textColor="#07518A"/>
   <Button android:id="@+id/btnLogout" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp" android:backgroundTint="#FFFFFF" android:text="Keluar" android:textColor="#C62828"/>
  </LinearLayout>
 </LinearLayout>
</ScrollView>