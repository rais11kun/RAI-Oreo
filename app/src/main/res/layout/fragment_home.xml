<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
  <ImageView android:layout_width="112dp" android:layout_height="112dp" android:layout_gravity="center_horizontal" android:layout_marginTop="8dp" android:src="@drawable/logo_simper" android:scaleType="fitCenter" android:contentDescription="Logo SIMPER-NRA" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="Selamat Datang di SIMPER-NRA" android:textColor="@color/primary_navy" android:textSize="23sp" android:textStyle="bold" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:text="Cetak Lebih Mudah, Pantau Lebih Cepat" android:textColor="@color/text_secondary" android:textSize="14sp" />
  <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="18dp" xmlns:app="http://schemas.android.com/apk/res-auto">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Layanan Percetakan" android:textColor="@color/primary_navy" android:textSize="18sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Banner, spanduk, stiker, undangan, ID card, nota, dan berbagai kebutuhan cetak lainnya." android:textColor="@color/text_secondary" android:textSize="14sp" />
    <Button android:id="@+id/btnMyProject" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="14dp" android:backgroundTint="@color/primary_navy" android:text="Lihat Katalog Layanan" android:textColor="@color/white" />
    <Button android:id="@+id/btnOpenWeb" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:backgroundTint="@color/primary_blue" android:text="Info Percetakan" android:textColor="@color/white" />
    <Button android:id="@+id/btnDeveloperProfile" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:backgroundTint="@color/white" android:text="Profil Pengembang" android:textColor="@color/primary_navy" />
    <Button android:id="@+id/btnLogout" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:backgroundTint="@color/white" android:text="Keluar" android:textColor="@color/error_red" />
   </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center" android:text="New Reklame Advertising • Pekanbaru" android:textColor="@color/text_secondary" android:textSize="12sp" />
 </LinearLayout>
</ScrollView>