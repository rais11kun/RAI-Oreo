<?xml version="1.0" encoding="utf-8"?>
<!--
  Tab Pesanan (Modul 11) — TabLayout dihubungkan ke ViewPager2 lewat
  TabLayoutMediator; tiga halaman: Aktif, Selesai, Dibatalkan.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pesanan Saya"
            android:textAppearance="@style/TextApp.H2" />

        <TextView
            android:id="@+id/tvSubPesanan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Pantau status produksi pesanan Anda"
            android:textAppearance="@style/TextApp.Muted" />
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:tabIndicatorColor="@color/primary"
        app:tabIndicatorFullWidth="false"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/primary"
        app:tabTextColor="@color/tab_text" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pagerPesanan"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
