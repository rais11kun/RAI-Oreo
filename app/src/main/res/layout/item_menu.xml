<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp"
    tools:ignore="HardcodedText">

    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_tile_blue"
        android:contentDescription="Menu"
        android:padding="9dp"
        android:src="@drawable/ic_person"
        app:tint="@color/blue" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvJudul"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit profil"
            android:textAppearance="@style/TextApp.Label"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Nama, email dan nomor telepon"
            android:textAppearance="@style/TextApp.Caption" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivChevron"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:contentDescription="Buka"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/muted" />

</LinearLayout>
