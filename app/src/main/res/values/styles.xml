<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============================================================ teks -->
    <style parent="" name="TextApp.H1">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style parent="" name="TextApp.H2">
        <item name="android:textSize">19sp</item>
        <item name="android:textColor">@color/navy800</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style parent="" name="TextApp.H3">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/navy800</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style parent="" name="TextApp.Title">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style parent="" name="TextApp.Body">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/body</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style parent="" name="TextApp.BodyStrong">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style parent="" name="TextApp.Muted">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style parent="" name="TextApp.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style parent="" name="TextApp.Label">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style parent="" name="TextApp.Price">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/orange</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style parent="" name="TextApp.PriceSmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/orange</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style parent="" name="TextApp.Pill">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style parent="" name="TextApp.Toolbar">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
    </style>

    <style parent="" name="TextApp.Link">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/blue</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- ========================================================== tombol -->
    <style parent="" name="Widget.App.Button.Primary">
        <item name="android:layout_height">54dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style parent="" name="Widget.App.Button.Outline">
        <item name="android:layout_height">54dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:background">@drawable/bg_btn_outline</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center</item>
    </style>

    <style parent="" name="Widget.App.Button.Small">
        <item name="android:layout_height">44dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
    </style>

    <style name="Widget.App.Button.SmallOutline" parent="Widget.App.Button.Small">
        <item name="android:background">@drawable/bg_btn_outline</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <!-- ============================================================ kartu -->
    <style name="Widget.App.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/ripple</item>
    </style>

    <style name="Widget.App.Card.Tight" parent="Widget.App.Card">
        <item name="cardCornerRadius">14dp</item>
    </style>

    <!-- ========================================================= toolbar -->
    <style name="Widget.App.Toolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:background">@color/surface</item>
        <item name="android:elevation">0dp</item>
        <item name="titleTextColor">@color/ink</item>
        <item name="subtitleTextColor">@color/muted</item>
        <item name="titleTextAppearance">@style/TextApp.Toolbar</item>
        <item name="titleCentered">true</item>
        <item name="navigationIconTint">@color/ink</item>
        <item name="android:theme">@style/ThemeOverlay.App.Toolbar</item>
    </style>

    <style name="ThemeOverlay.App.Toolbar" parent="ThemeOverlay.MaterialComponents.ActionBar">
        <item name="colorControlNormal">@color/ink</item>
    </style>

    <!-- ========================================================= input -->
    <style name="Widget.App.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeWidth">1.2dp</item>
        <item name="boxStrokeWidthFocused">1.6dp</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="hintTextColor">@color/muted</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="errorTextColor">@color/red</item>
    </style>

    <style parent="" name="Widget.App.EditText">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- ========================================================== chip -->
    <style name="Widget.App.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/chip_bg_selector</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">false</item>
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="chipStartPadding">12dp</item>
        <item name="chipEndPadding">12dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="rippleColor">@color/ripple</item>
    </style>

    <style name="ThemeOverlay.App.Chip" parent="">
        <item name="chipStyle">@style/Widget.App.Chip</item>
    </style>

    <!-- ==================================================== bottom nav -->
    <style name="Widget.App.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView.Colored">
        <item name="android:background">@color/surface</item>
        <item name="itemIconTint">@color/nav_item</item>
        <item name="itemTextColor">@color/nav_item</item>
        <item name="itemRippleColor">@color/ripple</item>
        <item name="itemIconSize">23dp</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">10dp</item>
    </style>

    <!-- ================================================== header gradien -->
    <style parent="" name="Widget.App.Header">
        <item name="android:background">@drawable/bg_gradient_header</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">18dp</item>
    </style>

</resources>
